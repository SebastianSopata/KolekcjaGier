<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KolekcjaGier.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KolekcjaGier"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Półka" 
                      Route="MainPage" 
                      Icon="dotnet_bot.png" 
                      ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent Title="O aplikacji" 
                      Route="OAplikacjiPage" 
                      Icon="dotnet_bot.png" 
                      ContentTemplate="{DataTemplate local:OAplikacjiPage}" />
    </TabBar>

</Shell>