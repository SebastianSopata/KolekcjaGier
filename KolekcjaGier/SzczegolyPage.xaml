<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:KolekcjaGier.Models"
             x:Class="KolekcjaGier.SzczegolyPage"
             x:DataType="models:Gra"
             BackgroundColor="{StaticResource TloAplikacji}"
             Title="Szczegóły Gry">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Karta szczegółów gry" FontSize="24" FontAttributes="Bold" TextColor="White" />

        <Image Source="{Binding Zdjecie}" HeightRequest="250" Aspect="AspectFit" />

        <!-- Wyświetlanie wszystkich właściwości (w tym bool i data z StringFormat) -->
        <Label Text="{Binding Tytul}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

        <Grid ColumnDefinitions="150, *" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="15">
            <Label Grid.Row="0" Grid.Column="0" Text="Platforma:" TextColor="#94A3B8" />
            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Platforma}" TextColor="White" FontAttributes="Bold" />

            <Label Grid.Row="1" Grid.Column="0" Text="Rok Wydania:" TextColor="#94A3B8" />
            <Label Grid.Row="1" Grid.Column="1" Text="{Binding RokWydania}" TextColor="White" FontAttributes="Bold" />

            <Label Grid.Row="2" Grid.Column="0" Text="Wersja pudełkowa:" TextColor="#94A3B8" />
            <Label Grid.Row="2" Grid.Column="1" Text="{Binding WersjaPudelkowa}" TextColor="White" FontAttributes="Bold" />

            <Label Grid.Row="3" Grid.Column="0" Text="Ocena:" TextColor="#94A3B8" />
            <Label Grid.Row="3" Grid.Column="1" Text="{Binding Ocena, StringFormat='{0:N1}/10'}" TextColor="#FBBF24" FontAttributes="Bold" />

            <Label Grid.Row="4" Grid.Column="0" Text="Data dodania:" TextColor="#94A3B8" />
            <Label Grid.Row="4" Grid.Column="1" Text="{Binding DataDodania, StringFormat='{0:d MMMM yyyy}'}" TextColor="White" FontAttributes="Bold" />
        </Grid>

        <Button Text="Wróć" Clicked="OnWrocClicked" Margin="0,30,0,0" />

    </VerticalStackLayout>
</ContentPage>