<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KolekcjaGier.SzczegolyPage"
             BackgroundColor="{StaticResource TloAplikacji}"
             Title="Szczegóły Gry">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="Karta szczegółów" 
               FontSize="24" 
               FontAttributes="Bold" 
               TextColor="White" />

        <Label x:Name="NumerWyswietlacz" 
               FontSize="18" 
               TextColor="{StaticResource Primary}" />

        <Button Text="Wróć" 
                Clicked="OnWrocClicked" />

    </VerticalStackLayout>
</ContentPage>