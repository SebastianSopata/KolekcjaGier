<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KolekcjaGier.MainPage"
             BackgroundColor="{StaticResource TloAplikacji}">

    <!-- Grid z trzema wierszami: Auto (nagłówek), * (środek), Auto (przyciski) -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="20">

        <!-- WIERSZ 0: Nagłówek (nazwa aplikacji) -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <Label Text="KOLEKCJA GIER" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="White" />
            <Label Text="Katalog okładek i wydań pudełkowych" 
                   FontSize="14" 
                   TextColor="#94A3B8" />
        </VerticalStackLayout>

        <!-- WIERSZ 1: Karta przykładowej gry w Border (wpisana na sztywno) -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout>

                <!-- Użycie stylu KartaGry nr 1: Główna karta gry z obrazem i 4 polami -->
                <Border Style="{StaticResource KartaGry}">
                    <VerticalStackLayout Spacing="12">

                        <!-- Obraz okładki lub samej gry z Resources/Images -->
                        <Image Source="wiedzmin3.jpg" 
                               HeightRequest="180" 
                               Aspect="AspectFit" />

                        <!-- Pole 1: Tytuł -->
                        <Label Text="Wiedźmin 3: Dziki Gon" 
                               FontSize="20" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalTextAlignment="Center" />

                        <!-- Pola 2, 3, 4: Platforma, Stan/Nośnik, Rok wydania -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                            <Label Grid.Row="0" Grid.Column="0" Text="Platforma: PS4" TextColor="#C4B5FD" FontAttributes="Bold" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Rok wydania: 2015" TextColor="#E2E8F0" HorizontalTextAlignment="End" />
                            <Label Grid.Row="1" Grid.Column="0" Text="Nośnik: Płyta Blu-ray + Box" TextColor="#34D399" />
                            <Label Grid.Row="1" Grid.Column="1" Text="Ocena wg krytyków: 9/10" TextColor="#FBBF24" FontAttributes="Bold" HorizontalTextAlignment="End" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Użycie stylu KartaGry nr 2: Druga ramka (wymóg użycia stylu min. 2 razy) -->
                <Border Style="{StaticResource KartaGry}">
                    <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="Stan kolekcji:" TextColor="#94A3B8" VerticalOptions="Center" />
                        <Label Text="1 gra na półce (100% wydań fizycznych)" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- WIERSZ 2: Przyciski na dole -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,12,0,0">
            <Button Grid.Column="0" 
                    Text="Dodaj grę / zdjęcie" 
                    Clicked="OnButtonClicked" />
            <Button Grid.Column="1" 
                    Text="Filtruj półkę" 
                    Clicked="OnButtonClicked" />
        </Grid>

    </Grid>
</ContentPage>