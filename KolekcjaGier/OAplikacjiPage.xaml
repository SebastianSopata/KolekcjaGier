<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KolekcjaGier.OAplikacjiPage"
             BackgroundColor="{StaticResource TloAplikacji}">

    <Grid Padding="20">
        <Border Style="{StaticResource KartaGry}" VerticalOptions="Center">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

                <Label Text="KOLEKCJA GIER" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" />

                <Label Text="Wersja 1.0" 
                       FontSize="14" 
                       TextColor="#94A3B8" 
                       HorizontalTextAlignment="Center" />

                <Label Text="Autor: Sebastian Sopata" 
                       FontSize="18" 
                       TextColor="#C4B5FD" 
                       FontAttributes="Bold" 
                       HorizontalTextAlignment="Center" />

                <Label Text="Aplikacja do katalogowania okładek i wydań pudełkowych gier." 
                       FontSize="14"
                       TextColor="#E2E8F0" 
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>